<Window x:Class="PhotoLocationEditor.App.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="Microsoft YaHei, Segoe UI Variable Text, Segoe UI, sans-serif"
        Width="900" Height="700" MinWidth="400" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Background}"
        Title="图片预览"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Image x:Name="FullImage" Grid.Row="0" Stretch="Uniform"
               HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <Border Grid.Row="1" Margin="0,6,0,0" Background="Transparent">
            <DockPanel>
                <Button x:Name="PrevButton" Content="上一张" Width="80" Height="30" Click="Prev_Click" DockPanel.Dock="Left"/>
                <Button x:Name="NextButton" Content="下一张" Width="80" Height="30" Click="Next_Click" DockPanel.Dock="Right"/>
                <TextBlock x:Name="InfoText" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
