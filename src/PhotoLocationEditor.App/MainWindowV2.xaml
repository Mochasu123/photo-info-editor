<Window x:Class="PhotoLocationEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, sans-serif"
        Title="Photo Info Editor"
        Width="1280" Height="800" MinWidth="1100" MinHeight="700"
        Background="{DynamicResource Background}"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======================= Sidebar ======================= -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBg}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="0,0,1,0"
                Padding="16,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,26">
                    <Border Width="40" Height="40" CornerRadius="10"
                            Background="{DynamicResource AccentSoft}">
                        <TextBlock Text="&#xE91B;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                   Foreground="{DynamicResource Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Photo Info" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Editor" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button x:Name="NavPhotosButton" Style="{StaticResource NavButton}" Click="NavPhotos_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NavPhotosText" Text="照片" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavLocationButton" Style="{StaticResource NavButton}" Click="NavLocation_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81D;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NavLocationText" Text="位置" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavDateButton" Style="{StaticResource NavButton}" Click="NavDate_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NavDateText" Text="日期" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavFormatButton" Style="{StaticResource NavButton}" Click="NavFormat_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NavFormatText" Text="格式" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavSettingsButton" Style="{StaticResource NavButton}" Click="NavSettings_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NavSettingsText" Text="设置" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <Border Style="{StaticResource StatusBadge}" Margin="0,0,0,10">
                        <TextBlock x:Name="ExifToolStatusText" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource StatusReady}" TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock x:Name="DropHintText" Text="拖拽照片或文件夹到窗口"
                               Foreground="{DynamicResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================= Main shell ======================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Style="{StaticResource ShellPanel}"
                    Padding="20,16" Margin="16,16,16,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="AppTitleText" Style="{StaticResource PageTitle}"/>
                            <Border Style="{StaticResource StatusBadge}" Margin="12,0,0,0" Padding="8,3">
                                <TextBlock Text="Workspace" Foreground="{DynamicResource Accent}"
                                           FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="ThemeLabel" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,6,0"/>
                            <ComboBox x:Name="ThemeComboBox" Width="126" FontSize="12"
                                      SelectionChanged="ThemeComboBox_SelectionChanged"/>
                            <TextBlock x:Name="LanguageLabel" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}" Margin="12,0,6,0"/>
                            <ComboBox x:Name="LanguageComboBox" Width="82" FontSize="12"
                                      SelectionChanged="LanguageComboBox_SelectionChanged">
                                <ComboBoxItem x:Name="ChineseLanguageItem" Tag="zh">中文</ComboBoxItem>
                                <ComboBoxItem Tag="en" Content="EN"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="AppSubtitleText" Style="{StaticResource PageSubtitle}" Margin="0,6,0,0"/>
                    <TextBlock x:Name="DropHintText2" Text="支持拖入照片、文件夹；批量写入 GPS / 拍摄时间，或转换格式。"
                               Foreground="{DynamicResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,10"/>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="WriteModeLabel" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,10,0"/>
                        <Border Grid.Column="1" Background="{DynamicResource SurfaceAlt}"
                                CornerRadius="8" Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="CopyModeItem" Style="{StaticResource SegmentButton}"
                                             Content="输出到新目录" Tag="copy" GroupName="MainWriteMode"
                                             Checked="WriteModeOption_Checked"/>
                                <RadioButton x:Name="DirectModeItem" Style="{StaticResource SegmentButton}"
                                             Content="直接写入原文件" Tag="direct" GroupName="MainWriteMode"
                                             IsChecked="True" Checked="WriteModeOption_Checked"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="WriteModeHintText" Grid.Column="2" VerticalAlignment="Center"
                                   FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                   TextWrapping="Wrap" Margin="12,0,0,0"/>
                    </Grid>

                    <Border x:Name="OutputDirContainer" Visibility="Visible" Margin="0,10,0,0">
                        <DockPanel HorizontalAlignment="Left">
                            <Button x:Name="BrowseOutputButton" Content="浏览" MinWidth="64"
                                    DockPanel.Dock="Right" Margin="8,0,0,0"
                                    Click="ChooseOutputDirectory_Click"/>
                            <TextBox x:Name="OutputDirectoryTextBox" Width="380" FontSize="12" MinHeight="32"/>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="16,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="520"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- Photo table area -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardPanelPlain}" Padding="10" Margin="0,0,0,10">
                        <WrapPanel>
                            <Button x:Name="AddPhotosButton" Content="添加照片" Click="AddFiles_Click"/>
                            <Button x:Name="AddFolderButton" Content="添加文件夹" Click="AddFolder_Click"/>
                            <CheckBox x:Name="IncludeSubfoldersCheckBox" Content="包含子文件夹"
                                      VerticalAlignment="Center" Margin="4,0,12,0" FontSize="13"/>
                            <Button x:Name="RemoveSelectedButton" Content="移除选中" Click="RemoveSelected_Click"/>
                            <Button x:Name="ClearButton" Content="清空" Click="Clear_Click"/>
                            <Separator Width="1" Margin="6,4,14,4"/>
                            <Button x:Name="SelectAllButton" Content="全选" Click="SelectAll_Click"/>
                            <Button x:Name="SelectNoneButton" Content="全不选" Click="SelectNone_Click"/>
                            <Button x:Name="MarkHighlightedButton" Content="选中高亮" Click="MarkHighlighted_Click"/>
                            <Button x:Name="UnmarkHighlightedButton" Content="取消高亮" Click="UnmarkHighlighted_Click"/>
                            <Button x:Name="InvertSelectionButton" Content="反选" Click="InvertSelection_Click"/>
                        </WrapPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource CardPanelPlain}" Padding="10" Margin="0,0,0,10">
                        <DockPanel LastChildFill="False">
                            <TextBox x:Name="FilterSearchBox" DockPanel.Dock="Right" Width="230" MinHeight="32"
                                     Padding="10,6" FontSize="12"/>
                            <WrapPanel VerticalAlignment="Center">
                                <Button Style="{StaticResource ChipButtonActive}" Content="全部"
                                        x:Name="FilterAllButton" Click="FilterAll_Click"/>
                                <Button Style="{StaticResource ChipButton}" Content="无 GPS"
                                        x:Name="FilterNoGpsButton" Click="FilterNoGps_Click"/>
                                <Button Style="{StaticResource ChipButton}" Content="有 GPS"
                                        x:Name="FilterHasGpsButton" Click="FilterHasGps_Click"/>
                                <Button Style="{StaticResource ChipButton}" Content="FUJIFILM"
                                        x:Name="FilterFujiButton" Click="FilterFuji_Click"/>
                                <Button Style="{StaticResource ChipButton}" Content="HUAWEI"
                                        x:Name="FilterHuaweiButton" Click="FilterHuawei_Click"/>
                                <Button Style="{StaticResource ChipButton}" Content="格式⚠"
                                        x:Name="FilterMismatchButton" Click="FilterMismatch_Click"/>
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="2" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            CornerRadius="8" Background="{DynamicResource Surface}" Padding="0">
                        <DataGrid x:Name="PhotoGrid" ItemsSource="{Binding Photos}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
                                  SelectionMode="Extended" CanUserReorderColumns="True"
                                  GridLinesVisibility="Horizontal"
                                  ColumnReordered="PhotoGrid_ColumnReordered"
                                  SelectionChanged="PhotoGrid_SelectionChanged"
                                  MouseDoubleClick="PhotoGrid_MouseDoubleClick"
                                  PreviewKeyDown="PhotoGrid_PreviewKeyDown"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  BorderThickness="0">
                            <DataGrid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="Padding" Value="6,2"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn x:Name="UseColumn" Header="使用" Width="52" MinWidth="52">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Click="UseCheckBox_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn x:Name="FileColumn" Header="文件" Binding="{Binding FileName}" IsReadOnly="True" Width="*" MinWidth="130"/>
                                <DataGridTextColumn x:Name="DateColumn" Header="日期" Binding="{Binding DateTakenDate}" IsReadOnly="True" Width="Auto" MinWidth="80"/>
                                <DataGridTextColumn x:Name="TimeColumn" Header="时间" Binding="{Binding DateTakenTime}" IsReadOnly="True" Width="Auto" MinWidth="54"/>
                                <DataGridTextColumn x:Name="DeviceColumn" Header="设备" Binding="{Binding CameraDisplay}" IsReadOnly="True" Width="Auto" MinWidth="100"/>
                                <DataGridTextColumn x:Name="CoordinatesColumn" Header="坐标" Binding="{Binding GpsDisplay}" IsReadOnly="True" Width="*" MinWidth="130"/>
                                <DataGridTemplateColumn x:Name="MapColumn" Header="Map" Width="54" MinWidth="54">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Map" Click="OpenPhotoMap_Click" Margin="0" MinHeight="26"
                                                    Padding="8,2" FontSize="12" Background="Transparent"
                                                    BorderThickness="0" Foreground="{DynamicResource Accent}"
                                                    Cursor="Hand" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn x:Name="FormatColumn" Header="格式" Binding="{Binding FormatDisplay}" IsReadOnly="True" Width="Auto" MinWidth="52"/>
                                <DataGridTextColumn x:Name="MismatchColumn" Header="⚠" Binding="{Binding MismatchDisplay}" IsReadOnly="True" Width="30" MinWidth="30"/>
                                <DataGridTextColumn x:Name="PathColumn" Header="路径" IsReadOnly="True" Width="*" MinWidth="150">
                                    <DataGridTextColumn.Binding><Binding Path="Path"/></DataGridTextColumn.Binding>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="ToolTip" Value="{Binding Path}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Border Grid.Row="3" Style="{StaticResource CardPanelPlain}" Padding="12,9" Margin="0,10,0,0">
                        <WrapPanel>
                            <TextBlock x:Name="StatsTotalText" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,22,0"/>
                            <TextBlock x:Name="StatsGpsText" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,22,0"/>
                            <TextBlock x:Name="StatsSelectedText" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,22,0"/>
                        </WrapPanel>
                    </Border>
                </Grid>

                <!-- Inspector and tools -->
                <ScrollViewer x:Name="ToolsScrollViewer" Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <Button x:Name="OpenSelectedMapButton" Content="Map" DockPanel.Dock="Right"
                                            MinHeight="30" Width="56" Padding="0" FontSize="12"
                                            Click="OpenSelectedMap_Click"/>
                                    <TextBlock x:Name="SelectedPhotoGroup" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                </DockPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="108" Height="78" Margin="0,0,12,0"
                                            BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                            CornerRadius="8" Background="{DynamicResource SurfaceSoft}"
                                            Cursor="Hand" MouseLeftButtonUp="Thumbnail_Click">
                                        <Image x:Name="PhotoThumbnail" Stretch="Uniform"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="SelectedPhotoText" FontSize="13"
                                                   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="SelectedGpsText" Margin="0,8,0,0" FontSize="13"
                                                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                        <Button x:Name="UseSelectedGpsButton" Content="填入 GPS 输入框"
                                                MinHeight="28" Padding="10,3" FontSize="12" Margin="0,6,0,0"
                                                HorizontalAlignment="Left" Click="UseSelectedGpsAsInput_Click"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardPanelGps}" Padding="0">
                            <Expander x:Name="GpsExpander" IsExpanded="True" Padding="16,14">
                                <Expander.Header>
                                    <TextBlock x:Name="GpsExpanderHeader" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                </Expander.Header>
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock x:Name="ManualInputHelpText" FontSize="12"
                                               Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>
                                    <TextBox x:Name="GpsInputTextBox" AcceptsReturn="True" MinHeight="54"
                                             TextWrapping="Wrap" FontSize="13"
                                             Foreground="{DynamicResource TextSecondary}"
                                             GotFocus="GpsInputTextBox_GotFocus"
                                             LostFocus="GpsInputTextBox_LostFocus"
                                             TextChanged="GpsInputTextBox_TextChanged"/>
                                    <DockPanel Margin="0,8,0,0">
                                        <Button x:Name="CoordinateSystemHelpButton" DockPanel.Dock="Right"
                                                Content="?" Width="32" MinHeight="32" Padding="0" Margin="8,0,0,0"
                                                Click="CoordinateSystemHelpButton_Click"/>
                                        <ComboBox x:Name="CoordinateSystemComboBox" MinHeight="32" FontSize="13"
                                                  SelectedIndex="0" SelectionChanged="CoordinateSystemComboBox_SelectionChanged">
                                            <ComboBoxItem x:Name="Wgs84CoordinateItem" Tag="wgs84" Content="WGS-84"/>
                                            <ComboBoxItem x:Name="Gcj02CoordinateItem" Tag="gcj02" Content="GCJ-02"/>
                                            <ComboBoxItem x:Name="Bd09CoordinateItem" Tag="bd09" Content="BD-09"/>
                                        </ComboBox>
                                    </DockPanel>
                                    <TextBlock x:Name="GpsPreviewText" Margin="0,8,0,0" FontSize="12"
                                               TextWrapping="Wrap"/>
                                    <UniformGrid Columns="2" Margin="0,8,0,0">
                                        <Button x:Name="MapPickerButton" Content="Map 选点" Margin="0,0,4,0"
                                                MinHeight="34" Padding="0" FontSize="13" Click="MapPickerButton_Click"/>
                                        <Button x:Name="ReferencePhotoButton" Content="参考照片" Margin="4,0,0,0"
                                                MinHeight="34" Padding="0" FontSize="13" Click="ReferencePhotoButton_Click"/>
                                    </UniformGrid>
                                    <Button x:Name="WriteButton" Style="{DynamicResource PrimaryButton}"
                                            MinHeight="42" FontSize="14" Margin="0,10,0,0" Click="WriteButton_Click"/>
                                </StackPanel>
                            </Expander>
                        </Border>

                        <Border Style="{StaticResource CardPanelDate}" Padding="0">
                            <Expander x:Name="DateToolsExpander" IsExpanded="False" Padding="16,14">
                                <Expander.Header>
                                    <TextBlock x:Name="DateToolsGroup" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                </Expander.Header>
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock x:Name="DateInfoExif" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="DateInfoFile" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="82"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock x:Name="DateLabel" Text="拍摄日期" FontSize="12"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                                                       Margin="0,0,0,4"/>
                                            <DatePicker x:Name="DatePickerField" Height="34" FontSize="13"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="来源" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                                            <Button x:Name="DateRefButton" Content="参考" MinHeight="34"
                                                    Padding="8,0" FontSize="12" Click="DateRef_Click"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="时间" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TimeInputBox" Width="72" Height="34" FontSize="14"
                                                     Text="00:00" HorizontalContentAlignment="Center"
                                                     VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                        <Grid Grid.Column="1" VerticalAlignment="Bottom">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="-H" MinHeight="34" Padding="0" FontSize="12" Margin="0,0,4,0" Click="TimeDownHour_Click"/>
                                            <Button Grid.Column="1" Content="+H" MinHeight="34" Padding="0" FontSize="12" Margin="0,0,4,0" Click="TimeUpHour_Click"/>
                                            <Button Grid.Column="2" Content="-M" MinHeight="34" Padding="0" FontSize="12" Margin="0,0,4,0" Click="TimeDownMin_Click"/>
                                            <Button Grid.Column="3" Content="+M" MinHeight="34" Padding="0" FontSize="12" Click="TimeUpMin_Click"/>
                                        </Grid>
                                    </Grid>
                                    <Button x:Name="WriteDateButton" Content="写入日期" Click="WriteDate_Click"
                                            MinHeight="34" FontSize="12" Margin="0,0,0,8"/>
                                    <Separator Height="1" Margin="0,2,0,8"/>
                                    <Button x:Name="DateCheckButton" Content="日期校对"
                                            Style="{DynamicResource PrimaryButton}" MinHeight="40" FontSize="13"
                                            Click="DateCheck_Click"/>
                                </StackPanel>
                            </Expander>
                        </Border>

                        <Border Style="{StaticResource CardPanelFormat}" Padding="0">
                            <Expander x:Name="FormatToolsExpander" IsExpanded="False" Padding="16,14">
                                <Expander.Header>
                                    <TextBlock x:Name="FormatToolsGroup" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                </Expander.Header>
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock x:Name="MismatchStatsText" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <Button x:Name="FixExtensionsButton" Content="更正后缀" Click="FixExtensions_Click"
                                            MinHeight="36" FontSize="13" Margin="0,0,0,10"/>
                                    <Separator Height="1" Margin="0,4,0,10"/>
                                    <TextBlock x:Name="ConvertFormatTitle" Text="目标格式" FontSize="13"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    <ComboBox x:Name="ConvertFormatComboBox" Margin="0,6,0,0" SelectedIndex="0" FontSize="13">
                                        <ComboBoxItem Tag="jpg" Content="JPEG (.jpg)"/>
                                        <ComboBoxItem Tag="png" Content="PNG (.png)"/>
                                        <ComboBoxItem Tag="bmp" Content="BMP (.bmp)"/>
                                        <ComboBoxItem Tag="gif" Content="GIF (.gif)"/>
                                        <ComboBoxItem Tag="tiff" Content="TIFF (.tiff)"/>
                                    </ComboBox>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock x:Name="ConvertWriteModeLabel" VerticalAlignment="Center"
                                                   FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                                   Margin="0,0,6,0"/>
                                        <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="8" Padding="3">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="ConvertCopyModeItem" Style="{StaticResource SegmentButton}"
                                                             Content="输出到新目录" Tag="copy" GroupName="ConvertWriteMode"
                                                             Checked="ConvertWriteModeOption_Checked"/>
                                                <RadioButton x:Name="ConvertDirectModeItem" Style="{StaticResource SegmentButton}"
                                                             Content="直接替换" Tag="direct" GroupName="ConvertWriteMode"
                                                             IsChecked="True" Checked="ConvertWriteModeOption_Checked"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <Border x:Name="ConvertOutputDirContainer" Margin="0,10,0,0">
                                        <DockPanel>
                                            <Button x:Name="ConvertBrowseButton" Content="浏览" MinHeight="32"
                                                    DockPanel.Dock="Right" Padding="8,0" Margin="8,0,0,0"
                                                    Click="ChooseOutputDirectory_Click"/>
                                            <TextBox x:Name="ConvertOutputTextBox" FontSize="12" MinHeight="32"/>
                                        </DockPanel>
                                    </Border>
                                    <Button x:Name="ConvertFormatButton" Content="转换格式"
                                            Style="{DynamicResource PrimaryButtonFormat}" MinHeight="40"
                                            Margin="0,10,0,0" Click="ConvertFormat_Click"/>
                                </StackPanel>
                            </Expander>
                        </Border>

                        <Border x:Name="SettingsPanel" Style="{StaticResource CardPanelPlain}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="设置 Settings" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                                <TextBlock Text="写入方式、输出目录、主题、语言和地图 Key 位于窗口顶部；高德 Key 在 Map 选点侧边栏配置。"
                                           Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="2" Style="{StaticResource CardPanelPlain}" Padding="12,8" Margin="16,10,16,14">
                <DockPanel>
                    <TextBlock x:Name="StatusText" DockPanel.Dock="Left" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="CancelOperationButton" DockPanel.Dock="Right" Content="取消"
                            Visibility="Collapsed" MinHeight="26" Padding="10,2" FontSize="11"
                            Margin="10,0,0,0" Click="CancelOperation_Click"/>
                    <ProgressBar x:Name="WriteProgressBar" DockPanel.Dock="Right" Width="190" Height="8"
                                 Visibility="Collapsed" IsIndeterminate="False" Maximum="100" Minimum="0"/>
                </DockPanel>
            </Border>

            <Border x:Name="ToastBorder" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,30" Background="{DynamicResource ToastBg}" CornerRadius="8"
                    Padding="20,12" Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="ToastText" Foreground="{DynamicResource ToastText}" FontSize="14"/>
            </Border>
        </Grid>
    </Grid>
</Window>
