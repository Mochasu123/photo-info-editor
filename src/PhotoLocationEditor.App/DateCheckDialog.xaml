<Window x:Class="PhotoLocationEditor.App.DateCheckDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="Microsoft YaHei, Segoe UI Variable Text, Segoe UI, sans-serif"
        Width="620" Height="560" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Background}"
        Title="日期校对">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="SummaryText" Grid.Row="0" FontSize="14" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="CategoryPanel"/>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <Button x:Name="CancelBtn" Content="取消" DockPanel.Dock="Left" Width="80" Height="34"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="ExecuteABBtn" Content="仅执行 A+B" Width="120" Height="34" Margin="0,0,8,0"/>
                <Button x:Name="ExecuteAllBtn" Content="全部执行" Width="100" Height="34"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
