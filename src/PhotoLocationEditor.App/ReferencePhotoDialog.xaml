<Window x:Class="PhotoLocationEditor.App.ReferencePhotoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="Microsoft YaHei, Segoe UI Variable Text, Segoe UI, sans-serif"
        Width="460" Height="380" MinWidth="400" MinHeight="340"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Background}"
        Title="">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="DialogTitle" Grid.Row="0" FontSize="14" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
        <TextBlock x:Name="TabHelpText" Grid.Row="1" FontSize="11"
                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <TabControl x:Name="MainTabControl" Grid.Row="2" AllowDrop="True"
                    DragOver="TabControl_DragOver" Drop="TabControl_Drop"
                    SelectionChanged="TabControl_SelectionChanged">

            <!-- Tab 0: Local file -->
            <TabItem x:Name="LocalFileTab" AllowDrop="True" Drop="TabItem_Drop">
                <TabItem.Header>
                    <Border x:Name="LocalFileTabHeader" Padding="4,2" Background="Transparent"
                            MouseMove="LocalFileTab_MouseMove">
                        <TextBlock x:Name="LocalFileTabText" Text="从本地文件选取"/>
                    </Border>
                </TabItem.Header>
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" x:Name="ChooseFileBtn" Height="34" Margin="0,0,0,10" Click="ChooseFile_Click"/>
                    <Border Grid.Row="1" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4" Padding="10">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="FileInfoText" Foreground="{DynamicResource TextSecondary}" FontSize="13"/>
                            <TextBlock x:Name="FileGpsText" Margin="0,6,0,0" Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="UseFileButton" Grid.Row="1" Content="" Height="34"
                            IsEnabled="False" VerticalAlignment="Bottom" Click="UseFile_Click"/>
                </Grid>
            </TabItem>

            <!-- Tab 1: Imported -->
            <TabItem x:Name="ImportedTab" AllowDrop="True" Drop="TabItem_Drop">
                <TabItem.Header>
                    <Border x:Name="ImportedTabHeader" Padding="4,2" Background="Transparent"
                            MouseMove="ImportedTab_MouseMove">
                        <TextBlock x:Name="ImportedTabText" Text="从已导入选取"/>
                    </Border>
                </TabItem.Header>
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="EmptyHintText" Grid.Row="0"
                               Visibility="Collapsed" FontSize="12" Foreground="{DynamicResource Warning}"
                               TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <ListBox x:Name="ImportedListBox" Grid.Row="1" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,6">
                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
                                    <TextBlock Text="{Binding GpsDisplay}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button x:Name="UseImportedButton" Grid.Row="2" Margin="0,10,0,0" Height="34" Click="UseImported_Click"/>
                </Grid>
            </TabItem>
        </TabControl>

        <Button Grid.Row="3" x:Name="CancelBtn" Height="34" Margin="0,10,0,0" Click="Cancel_Click"/>
    </Grid>
</Window>
