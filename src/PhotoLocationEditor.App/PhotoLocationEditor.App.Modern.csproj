<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>appicon.ico</ApplicationIcon>
    <AssemblyName>PhotoInfoEditor</AssemblyName>
    <RootNamespace>PhotoLocationEditor.App</RootNamespace>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3124.44" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms is only used through System.Drawing for image encoding; remove implicit Forms usings. -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep the legacy project's obj\ (PhotoLocationEditor.App.csproj) out of this project's default globs -->
    <Compile Remove="obj\**\*.cs" />
    <Page Remove="obj\**\*.xaml" />
    <ApplicationDefinition Remove="obj\**\*.xaml" />
    <EmbeddedResource Remove="obj\**" />
    <None Remove="obj\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Legacy WPF windows/dialogs/services replaced by the Hybrid WebView2 Studio & Services -->
    <Page Remove="MainWindow.xaml" />
    <Page Remove="DateCheckDialog.xaml" />
    <Page Remove="MapPickerWindow.xaml" />
    <Page Remove="PreviewWindow.xaml" />
    <Page Remove="ReferencePhotoDialog.xaml" />
    <Page Remove="Themes\*.xaml" />
    <Compile Remove="MainWindow.xaml.cs" />
    <Compile Remove="DateCheckDialog.xaml.cs" />
    <Compile Remove="DateCheckItem.cs" />
    <Compile Remove="MapPickerWindow.xaml.cs" />
    <Compile Remove="PreviewWindow.xaml.cs" />
    <Compile Remove="ReferencePhotoDialog.xaml.cs" />
    <Compile Remove="Services\ImageConversionService.cs" />
    <Compile Remove="Services\ExifToolService.cs" />
    <Compile Remove="Models\WriteMode.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Tools\**\*.*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="WebUI\**\*.*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>

</Project>
