<Window x:Class="PhotoLocationEditor.App.MapPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        Width="1040"
        Height="680"
        MinWidth="860"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Background}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="Search a POI or address, or click the map to pick a GPS coordinate."
                           FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>
            <TextBlock x:Name="CoordinateText"
                       DockPanel.Dock="Right"
                       VerticalAlignment="Center"
                       FontSize="13"
                       Foreground="{DynamicResource TextPrimary}"/>
        </DockPanel>

        <!-- Main content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Map -->
            <Border Grid.Column="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Margin="0,0,12,0">
                <wv2:WebView2 x:Name="MapWebView"/>
            </Border>

            <!-- Sidebar -->
            <Border Grid.Column="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="12">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="地图源" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="MapProviderComboBox"
                                  Height="34"
                                  Margin="0,0,0,10"
                                  SelectionChanged="MapProviderComboBox_SelectionChanged">
                            <ComboBoxItem Tag="amap" Content="高德地图"/>
                            <ComboBoxItem Tag="osm" Content="OpenStreetMap"/>
                        </ComboBox>

                        <TextBlock Text="图层" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="MapLayerComboBox"
                                  Height="34"
                                  Margin="0,0,0,12"
                                  SelectionChanged="MapLayerComboBox_SelectionChanged"/>

                        <TextBlock Text="搜索" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                        <DockPanel Margin="0,0,0,10">
                            <Button x:Name="SearchButton"
                                    DockPanel.Dock="Right"
                                    Width="76"
                                    Height="34"
                                    Margin="8,0,0,0"
                                    Content="搜索"
                                    Click="SearchButton_Click"/>
                            <TextBox x:Name="SearchTextBox"
                                     Height="34"
                                     Padding="8,6"
                                     VerticalContentAlignment="Center"
                                     KeyDown="SearchTextBox_KeyDown"/>
                        </DockPanel>

                        <Expander Header="高德配置 / AMap Key" Margin="0,0,0,10" Foreground="{DynamicResource TextPrimary}">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="不配置时使用 OpenStreetMap；配置后可切换到高德地图。" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock Text="JS Key" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBox x:Name="AmapKeyTextBox" Margin="0,4,0,8"/>
                                <TextBlock Text="Security JS Code" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBox x:Name="AmapSecurityTextBox" Margin="0,4,0,8"/>
                                <Button x:Name="SaveAmapSettingsButton" Content="保存高德配置" Click="SaveAmapSettings_Click" Margin="0"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <ListBox x:Name="SearchResultsListBox"
                             BorderBrush="{DynamicResource Border}"
                             BorderThickness="1"
                             SelectionChanged="SearchResultsListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,6">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" FontSize="13"/>
                                    <TextBlock Text="{Binding Address}" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Bottom bar -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText"
                       DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="UseButton"
                        Width="140"
                        Height="34"
                        Margin="0,0,8,0"
                        Click="UseButton_Click"/>
                <Button x:Name="CancelButton"
                        Width="90"
                        Height="34"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
