<Window x:Class="PhotoLocationEditor.App.MapPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Width="1040"
        Height="680"
        MinWidth="860"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" Foreground="#1F2937"/>
                <TextBlock Text="Search a POI or address, or click the map to pick a GPS coordinate."
                           Foreground="#6B7280"
                           Margin="0,4,0,0"/>
            </StackPanel>
            <TextBlock x:Name="CoordinateText"
                       DockPanel.Dock="Right"
                       VerticalAlignment="Center"
                       Foreground="#1F2937"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1">
                <wv2:WebView2 x:Name="MapWebView"/>
            </Border>

            <Border Grid.Column="1" Margin="10,0,0,0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Map Source" Foreground="#6B7280" Margin="0,0,0,4"/>
                        <ComboBox x:Name="MapProviderComboBox"
                                  Height="34"
                                  Margin="0,0,0,8"
                                  SelectionChanged="MapProviderComboBox_SelectionChanged">
                            <ComboBoxItem Tag="amap" Content="高德地图"/>
                            <ComboBoxItem Tag="osm" Content="OpenStreetMap"/>
                        </ComboBox>

                        <TextBlock Text="Layer" Foreground="#6B7280" Margin="0,0,0,4"/>
                        <ComboBox x:Name="MapLayerComboBox"
                                  Height="34"
                                  Margin="0,0,0,12"
                                  SelectionChanged="MapLayerComboBox_SelectionChanged"/>

                        <TextBlock Text="Search" Foreground="#6B7280" Margin="0,0,0,4"/>
                        <DockPanel Margin="0,0,0,10">
                            <Button x:Name="SearchButton"
                                    DockPanel.Dock="Right"
                                    Width="76"
                                    Height="34"
                                    Margin="8,0,0,0"
                                    Content="Search"
                                    Click="SearchButton_Click"/>
                            <TextBox x:Name="SearchTextBox"
                                     Height="34"
                                     Padding="8,6"
                                     VerticalContentAlignment="Center"
                                     KeyDown="SearchTextBox_KeyDown"/>
                        </DockPanel>
                        <Expander Header="高德配置 / AMap Key" Margin="0,0,0,10">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="不配置时使用 OpenStreetMap；配置后可切换到高德地图。" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock Text="JS Key" Foreground="#6B7280"/>
                                <TextBox x:Name="AmapKeyTextBox" Margin="0,4,0,8"/>
                                <TextBlock Text="Security JS Code" Foreground="#6B7280"/>
                                <TextBox x:Name="AmapSecurityTextBox" Margin="0,4,0,8"/>
                                <Button x:Name="SaveAmapSettingsButton" Content="保存高德配置" Click="SaveAmapSettings_Click" Margin="0"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <ListBox x:Name="SearchResultsListBox"
                             BorderBrush="#E5E7EB"
                             BorderThickness="1"
                             SelectionChanged="SearchResultsListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,6">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#111827" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Address}" Foreground="#6B7280" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText"
                       DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Foreground="#6B7280"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="UseButton"
                        Width="140"
                        Height="34"
                        Margin="0,0,8,0"
                        Click="UseButton_Click"/>
                <Button x:Name="CancelButton"
                        Width="90"
                        Height="34"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
