<Window x:Class="PhotoLocationEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Photo Info Editor"
        Width="1400" Height="880" MinWidth="1060" MinHeight="680"
        Background="#090B10"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="12"
                            GlassFrameThickness="1"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid x:Name="RootGrid" Background="#090B10">
        <wv2:WebView2 x:Name="StudioWebView"
                      DefaultBackgroundColor="#FF090B10"
                      Visibility="Hidden" />
        <Border x:Name="SplashOverlay" Background="#090B10">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="PHOTO INFO EDITOR"
                           Foreground="#C9D8EE"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="15"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Lumina Chronos &amp; Atlas Studio"
                           Foreground="#6C788C"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="12"
                           Margin="0,6,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
