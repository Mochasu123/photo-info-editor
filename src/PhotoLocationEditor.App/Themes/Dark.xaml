<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark theme: deep charcoal, inspired by VS Code dark -->
    <SolidColorBrush x:Key="Surface" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="SurfaceSoft" Color="#18181B"/>
    <SolidColorBrush x:Key="Background" Color="#141414"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#D4D4D4"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#9D9D9D"/>
    <SolidColorBrush x:Key="TextMuted" Color="#71717A"/>
    <SolidColorBrush x:Key="Border" Color="#333333"/>
    <SolidColorBrush x:Key="Accent" Color="#0078D4"/>
    <SolidColorBrush x:Key="AccentHover" Color="#1A8AD4"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#102A43"/>
    <SolidColorBrush x:Key="Divider" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="Success" Color="#4EC9B0"/>
    <SolidColorBrush x:Key="Warning" Color="#D67B2E"/>
    <SolidColorBrush x:Key="Danger" Color="#F87171"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#3A1F1F"/>

    <SolidColorBrush x:Key="RowHover" Color="#2A2D2E"/>
    <SolidColorBrush x:Key="RowSelected" Color="#0078D4"/>
    <SolidColorBrush x:Key="RowSelectedText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="RowAlt" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="ToastBg" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="ToastText" Color="#1E1E1E"/>

    <!-- Status bar colors -->
    <SolidColorBrush x:Key="StatusReady" Color="#4FC1FF"/>
    <SolidColorBrush x:Key="StatusReadyBg" Color="#1A2B3C"/>

    <!-- Button colors -->
    <SolidColorBrush x:Key="ButtonBg" Color="#333333"/>
    <SolidColorBrush x:Key="ButtonHover" Color="#3D3D3D"/>
    <SolidColorBrush x:Key="ButtonText" Color="#D4D4D4"/>

    <!-- Card accent stripes -->
    <SolidColorBrush x:Key="CardAccent" Color="#0078D4"/>
    <SolidColorBrush x:Key="CardAccentGps" Color="#D67B2E"/>
    <SolidColorBrush x:Key="CardAccentFormat" Color="#4EC9B0"/>
    <SolidColorBrush x:Key="CardAccentFormatHover" Color="#3EAD96"/>
    <SolidColorBrush x:Key="CardAccentDate" Color="#BB86FC"/>

    <!-- Modern additions -->
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FocusBrush" Color="#4FC1FF"/>
    <SolidColorBrush x:Key="InputBg" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="SurfaceAlt" Color="#252526"/>
    <SolidColorBrush x:Key="ChipBg" Color="#252526"/>
    <SolidColorBrush x:Key="ChipText" Color="#C8C8C8"/>
    <SolidColorBrush x:Key="SidebarBg" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="OverlayBg" Color="#88000000"/>
</ResourceDictionary>
