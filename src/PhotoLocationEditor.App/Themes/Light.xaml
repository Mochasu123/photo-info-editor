<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light theme: gentle white/gray, low contrast -->
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Background" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#212121"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#5A5A5A"/>
    <SolidColorBrush x:Key="Border" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="Accent" Color="#0078D4"/>
    <SolidColorBrush x:Key="AccentHover" Color="#106EBE"/>
    <SolidColorBrush x:Key="Divider" Color="#EDEDED"/>
    <SolidColorBrush x:Key="Success" Color="#107C10"/>
    <SolidColorBrush x:Key="Warning" Color="#D87B00"/>

    <SolidColorBrush x:Key="RowHover" Color="#EAF3FA"/>
    <SolidColorBrush x:Key="RowSelected" Color="#0078D4"/>
    <SolidColorBrush x:Key="RowSelectedText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="RowAlt" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="ToastBg" Color="#323130"/>
    <SolidColorBrush x:Key="ToastText" Color="#FFFFFF"/>

    <!-- Status bar colors -->
    <SolidColorBrush x:Key="StatusReady" Color="#0078D4"/>
    <SolidColorBrush x:Key="StatusReadyBg" Color="#E8F4FD"/>

    <!-- Button colors -->
    <SolidColorBrush x:Key="ButtonBg" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="ButtonHover" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="ButtonText" Color="#212121"/>

    <!-- Card accent stripes -->
    <SolidColorBrush x:Key="CardAccent" Color="#0078D4"/>
    <SolidColorBrush x:Key="CardAccentGps" Color="#D87B00"/>
    <SolidColorBrush x:Key="CardAccentFormat" Color="#107C10"/>
    <SolidColorBrush x:Key="CardAccentFormatHover" Color="#0E6A0E"/>
    <SolidColorBrush x:Key="CardAccentDate" Color="#7B1FA2"/>
</ResourceDictionary>
