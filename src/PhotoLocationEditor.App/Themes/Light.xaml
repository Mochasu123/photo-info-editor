<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light theme: clean blue-white workspace -->
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceSoft" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="Background" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#1E293B"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#64748B"/>
    <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>
    <SolidColorBrush x:Key="Border" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="Accent" Color="#3B82F6"/>
    <SolidColorBrush x:Key="AccentHover" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#EFF6FF"/>
    <SolidColorBrush x:Key="Divider" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="Success" Color="#059669"/>
    <SolidColorBrush x:Key="Warning" Color="#D97706"/>
    <SolidColorBrush x:Key="Danger" Color="#DC2626"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#FEF2F2"/>

    <SolidColorBrush x:Key="RowHover" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="RowSelected" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="RowSelectedText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="RowAlt" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="ToastBg" Color="#0F172A"/>
    <SolidColorBrush x:Key="ToastText" Color="#FFFFFF"/>

    <!-- Status bar colors -->
    <SolidColorBrush x:Key="StatusReady" Color="#2563EB"/>
    <SolidColorBrush x:Key="StatusReadyBg" Color="#EFF6FF"/>

    <!-- Button colors -->
    <SolidColorBrush x:Key="ButtonBg" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="ButtonHover" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="ButtonText" Color="#1E293B"/>

    <!-- Card accent stripes -->
    <SolidColorBrush x:Key="CardAccent" Color="#3B82F6"/>
    <SolidColorBrush x:Key="CardAccentGps" Color="#3B82F6"/>
    <SolidColorBrush x:Key="CardAccentFormat" Color="#059669"/>
    <SolidColorBrush x:Key="CardAccentFormatHover" Color="#047857"/>
    <SolidColorBrush x:Key="CardAccentDate" Color="#6366F1"/>

    <!-- Modern additions -->
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FocusBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="InputBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAlt" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="ChipBg" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="ChipText" Color="#64748B"/>
    <SolidColorBrush x:Key="SidebarBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OverlayBg" Color="#66000000"/>
</ResourceDictionary>
